{
	"name": "midi-mix-dash",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"build": "tsc -b && vite build",
		"test": "vitest run tests",
		"preview": "vite preview",
		"test:e2e": "playwright test",
		"format": "prettier --write src scripts tests e2e *.ts *.json *.js",
		"lint": "eslint src",
		"lint:fix": "eslint --fix src",
		"format:check": "prettier --check src scripts tests e2e *.ts *.json *.js",
		"build:spa": "tsc -b && vite build --base=/midi-mix-dash/"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@mui/icons-material": "^7.3.0",
		"@mui/material": "^7.3.0",
		"jszip": "^3.10.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"single-spa-react": "^6.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.63.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^5.0.0",
		"eslint": "^9.39.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.26",
		"globals": "^15.15.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.8",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.70.1",
		"vite": "^7.1.0",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@10.18.0",
	"license": "AGPL-3.0-only"
}
